{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.json"],
  "options": {
    "typeAware": false,
    // Non-type-aware passes never exercise type-aware rules, so their disable
    // directives surface as warnings here; the full type-aware lint owns the
    // blocking report. "warn" keeps the staged pass non-failing while the
    // fix/report channel the oxlint contract pins stays observable.
    "reportUnusedDisableDirectives": "warn"
  },
  "ignorePatterns": [
    "**/lib/**",
    "**/node_modules/**",
    "**/.sessions/**",
    ".claude/**",
    "**/.doc-typecheck-*/**",
    "**/.node-next-types-*/**",
    "website/.generated/**",
    "vendor/**",
    "native/**",
    "**/*.js",
    "**/*.mjs",
    "**/*.config.ts",
    "packages/client/tsdown.client.ts"
  ]
}
